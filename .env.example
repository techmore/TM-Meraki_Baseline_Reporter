# Copy to .env and fill in locally. .env is git-ignored; never commit real keys.
#
# The key is resolved in this order: shell environment, this file,
# MERAKI_API_KEY_FILE, then the OS keyring (`python meraki_env.py store`).
MERAKI_API_KEY=your_key_here

# Alternative: a file that contains only the key (Docker/Kubernetes secrets).
# MERAKI_API_KEY_FILE=/run/secrets/meraki_api_key

# Optional API client tuning.
# MERAKI_API_BASE=https://api.meraki.com/api/v1
# MERAKI_REQUEST_TIMEOUT=30
# MERAKI_MAX_RETRIES=5

# Optional: local Ollama model for the AI review stage (./run.sh --model also works).
# OLLAMA_MODEL=gemma4:e2b
